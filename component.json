{
  "schemaVersion": "f8component/1",
  "componentId": "media-gateway",
  "version": "0.1.0",
  "title": "Media Gateway",
  "launch": {
    "environment": "media",
    "module": "f8media_gateway",
    "args": [
      "--host",
      "127.0.0.1",
      "--port",
      "${F8_PORT:media-gateway.http}",
      "--exit-on-stdin-close"
    ],
    "distribution": "f8media-gateway"
  },
  "provides": [
    {
      "protocolId": "f8media-api",
      "version": "1.0"
    }
  ],
  "endpoints": [
    {
      "name": "http",
      "url": "http://127.0.0.1:8211"
    }
  ],
  "health": {
    "endpoint": "http",
    "path": "/api/health",
    "service": "f8media-gateway",
    "protocolVersion": "f8media-api/1"
  }
}
